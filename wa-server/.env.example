# wa-server 环境配置
# 复制为 .env 后按需修改,或在 shell 中 export。

# Redis 连接 (任务队列 + registry + 事件流)
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL 连接 (持久化)。设置后 wa-server 使用 PG 存储,未设置则退回内存存储
DATABASE_URL=postgres://postgres:123456@localhost:5432/mydb

# 本 pod 标识。多 pod 部署时每个 pod 不同 (k8s 用 POD_ID env / statefulset 序号)
POD_ID=pod-1

# 每 pod 最大并发 session 数,0 = 不限制
MAX_SESSIONS=0

# HTTP API 监听地址
API_ADDR=0.0.0.0:8080
