# wa-server 环境配置
# 复制为 .env 后按需修改,或在 shell 中 export。

# Redis 连接 (任务队列 + registry + 事件流)
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL 连接 (持久化)。设置后 wa-server 使用 PG 存储,未设置则退回内存存储
DATABASE_URL=postgres://postgres:123456@localhost:5432/mydb

# 本 pod 标识。多 pod 部署时每个 pod 不同 (k8s 用 POD_ID env / statefulset 序号)
POD_ID=pod-1

# 每 pod 最大并发 session 数,0 = 不限制
MAX_SESSIONS=0

# HTTP API 监听地址
API_ADDR=0.0.0.0:8080

# 可选: WhatsApp WebSocket 连接走 HTTP CONNECT 代理(如本地 Clash 127.0.0.1:7890)
# 设置后所有 session 的传输层走该代理;生产直连时留空即可
# WA_PROXY_URL=http://127.0.0.1:7890

# 配对码 Redis key 前缀。客户端轮询 GET /pair-code?phone=... 时读取
# 实际 key 为 {prefix}:{phone},例如 wa-pair-code:861866620688
PAIR_CODE_KEY_PREFIX=wa-pair-code

# 启动时是否自动恢复已配对设备(重连 + 自动订阅联系人 presence)。
# 多 pod 部署建议 true: 新 pod 启动后自动接管空闲设备;如果某个 pod 只处理
# 新任务而不想抢设备,可设 false。
RESTORE_ON_START=true
