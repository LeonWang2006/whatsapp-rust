# Quadlet unit: PostgreSQL 16 (wa-server shared store)
# Install: cp wa-server/deploy/systemd/*.container ~/.config/containers/systemd/
# Then: systemctl --user daemon-reload && systemctl --user start wa-postgres
#
# Boot autostart: the [Install] section is auto-applied by the Quadlet generator
# (no systemctl --user enable needed); WSL boot starts user default.target which
# pulls these in via default.target.wants.

[Unit]
Description=WhatsApp Rust PostgreSQL (wa-postgres)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=wa-postgres
Image=docker.io/library/postgres:16
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_PASSWORD=123456
Environment=POSTGRES_DB=mydb
Environment=POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C
PublishPort=5432:5432
Volume=compose_pg_data:/var/lib/postgresql/data
HealthCmd=/usr/bin/pg_isready -U postgres -d mydb
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=10s

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
